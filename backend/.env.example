# Servidor
PORT=3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=attendant_db
PGUSER=postgres
PGPASSWORD=postgrespassword
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/attendant_db

# Ollama (modelo do agente). Fica no hot path da conversa — timeout curto:
# melhor cair no fallback da persona do que deixar o cliente esperando.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=30000

# Provedor do modelo do agente: ollama (default, dev) | anthropic | openai | gemini.
# Tool calling com modelo pequeno local é instável — para o piloto com
# restaurante real use um modelo hospedado. LLM_MODEL vazio = default do provedor
# (ollama: OLLAMA_MODEL, anthropic: claude-sonnet-5-5, openai: gpt-4o-mini,
# gemini: gemini-2.5-flash).
# LLM_TIMEOUT_MS vale por chamada ao modelo (default: OLLAMA_TIMEOUT_MS).
LLM_PROVIDER=ollama
# LLM_MODEL=
# LLM_TIMEOUT_MS=30000
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Chave da API do Gemini (Google AI Studio). Separada da chave de geocoding.
# GEMINI_API_KEY=

# Base pública do frontend (link do cardápio que o atendente envia: <base>/c/<token>).
# Em produção precisa ser a URL real do site; vazio desliga o link.
PUBLIC_APP_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# Auth (JWT HS256)
# Em produção o boot recusa subir com este valor de exemplo ou com menos de
# 32 caracteres — ver assertProductionSecrets() em src/config/env.ts.
#   export JWT_SECRET="$(openssl rand -base64 48)"
JWT_SECRET=dev-insecure-jwt-secret-change-me-please
JWT_EXPIRES_IN_SECONDS=28800

# WhatsApp Cloud API (developers.facebook.com → seu app → WhatsApp)
# Token que VOCÊ inventa e cola no painel ao registrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret (Configurações do app → Básico). Sem ele o webhook recusa tudo.
WHATSAPP_APP_SECRET=
# Token de acesso (temporário no API Setup, ou de System User em produção).
# Vazio = respostas não são enviadas; só o simulador funciona.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0

# OpenStreetMap (aba Entrega: contorno da cidade e dos bairros)
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Lista separada por vírgula; tentadas em ordem.
# OSM_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# OSM_USER_AGENT=attendant/1.0 (contato@seudominio.com)
# OSM_TIMEOUT_MS=60000

# Google Geocoding (botão "Localizar pelo endereço"). Chave de SERVIDOR, com a
# Geocoding API ativada e restrita por IP — não é a chave do mapa (frontend).
# GOOGLE_GEOCODING_API_KEY=
# GOOGLE_TIMEOUT_MS=10000

# Seed (npm run seed)
# SEED_ADMIN_PASSWORD=123456
# phone_number_id do número de teste (API Setup) — liga o tenant demo ao WhatsApp.
# SEED_WHATSAPP_PHONE_NUMBER_ID=

# Base da API. O Vite embute em BUILD time: mudar depois de `vite build` não
# tem efeito — para o container, passe como build arg (ver docker-compose.yml).
VITE_API_BASE_URL=http://localhost:3000

# Chave de NAVEGADOR do Google Maps (Maps JavaScript API), restrita por HTTP
# referrer no Google Cloud. Também é embutida em BUILD time. Vazia = os mapas
# do painel mostram um aviso. (O Geocoding usa outra chave, a do backend.)
VITE_GOOGLE_MAPS_API_KEY=

# Opcional: Map ID vetorial (Google Cloud → Map Management) com a camada de
# limites "Locality" ativada. Com ele a aba Entrega usa o contorno da cidade do
# próprio Google; sem ele, o município do OpenStreetMap.
VITE_GOOGLE_MAPS_MAP_ID=
